#compdef git-wt
_git_wt_managed_worktrees () {
	local common_directory repository_root managed_prefix line worktree_path name
	local -a worktrees=() 
	common_directory=$(command git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)  || return 1
	repository_root=${common_directory:h} 
	managed_prefix="${repository_root}/${GIT_WT_WORKTREES_DIRECTORY_NAME}/" 
	while IFS= read -r line
	do
		if [[ $line == worktree\ * ]]
		then
			worktree_path=${line#worktree } 
			if [[ $worktree_path == ${managed_prefix}* ]]
			then
				name=${worktree_path#$managed_prefix} 
				if [[ -n $name && $name != */* ]]
				then
					worktrees+=("$name") 
				fi
			fi
		fi
	done < <(command git worktree list --porcelain 2>/dev/null)
	_describe -t worktrees 'managed worktree' worktrees
}
_git-wt () {
	_arguments -s '--init[initialize worktree files]' '--completions[print Zsh completions]' '--rm[remove a managed worktree]' '--force[pass force behavior to git worktree]' '1:worktree name:_git_wt_managed_worktrees'
}
