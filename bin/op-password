#!/bin/bash

DEFAULT_PASSWORD_LENGTH=32
password_length="$DEFAULT_PASSWORD_LENGTH"

while (( $# > 0 )); do
  case "$1" in
    --length)
      if (( $# < 2 )); then
        printf '%s\n' 'op-password: --length requires a value' >&2
        exit 2
      fi

      password_length="$2"
      shift 2
      ;;
    *)
      printf 'op-password: unknown option: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

op item create \
  --dry-run \
  --category Password \
  --generate-password="letters,digits,symbols,$password_length" \
  --format json \
  | jq -r '.fields[] | select(.id == "password").value'
